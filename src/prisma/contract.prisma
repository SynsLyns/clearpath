// use prisma-8

model Submission {
  id           String       @id @onCreate(uuid())
  partner      String
  product      String
  channel      String
  creativeText String
  status       String       @default("pending")
  riskScore    Int          @default(0)
  ruleVersion  String
  submittedBy  String
  qaSample     Boolean      @default(false)
  version      Int          @default(1)
  parentId     String?
  createdAt    DateTime     @default(now()) @onCreate(now())
  parent       Submission?  @relation("SubmissionVersions", fields: [parentId], references: [id], onDelete: Cascade)
  children     Submission[] @relation("SubmissionVersions")
  ruleChecks   RuleCheck[]
  reviews      Review[]
  auditEvents  AuditEvent[]
  attachments  Attachment[]

  @@index([status, createdAt])
  @@index([parentId])
}

model RuleCheck {
  id           String     @id @onCreate(uuid())
  submissionId String
  ruleId       String
  severity     String
  passed       Boolean
  message      String
  authority    String?
  snippet      String
  dismissed    Boolean    @default(false)
  dismissedBy  String?
  dismissNote  String?
  sourceName   String?
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
}

model Attachment {
  id           String     @id @onCreate(uuid())
  submissionId String
  kind         String
  name         String
  url          String
  contentType  String?
  sizeBytes    Int?
  extractionStatus String     @default("not_processed")
  extractedText    String?
  extractionError  String?
  extractionMethod String?
  extractedAt      DateTime?
  createdAt        DateTime   @default(now()) @onCreate(now())
  submission       Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId, createdAt])
}

model Review {
  id           String     @id @onCreate(uuid())
  submissionId String
  reviewer     String
  decision     String
  reasonCode   String?
  comment      String
  ruleVersion  String
  createdAt    DateTime   @default(now()) @onCreate(now())
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId, createdAt])
}

model AuditEvent {
  id           String     @id @onCreate(uuid())
  submissionId String
  actor        String
  action       String
  detail       String
  createdAt    DateTime   @default(now()) @onCreate(now())
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId, createdAt])
}

model ExportLog {
  id        String   @id @onCreate(uuid())
  actor     String
  kind      String
  filters   String
  rowCount  Int
  createdAt DateTime @default(now()) @onCreate(now())

  @@index([createdAt])
}
